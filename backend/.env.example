# AI System Environment Configuration
# Copy this to .env and fill in your values

PORT=3000
NODE_ENV=development
DATABASE_URL=./data/ai-system.db
JWT_SECRET=your-jwt-secret-here

# OpenRouter API Key (get from openrouter.ai/keys)
OPENROUTER_KEY=

# OmniRoute (optional)
OMNIROUTE_KEY=
OMNIROUTE_URL=http://localhost:20128/v1

# FreeLLMAPI (optional)
FREELLMAPI_KEY=
FREELLMAPI_URL=http://localhost:3001/v1
